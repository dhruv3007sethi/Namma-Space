{
  "name": "@namma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Namma Space REST API",
  "scripts": {
    "dev": "tsx watch --conditions=@namma/source --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "pnpm --filter @namma/shared build && drizzle-kit generate",
    "db:migrate": "tsx --conditions=@namma/source --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/multipart": "^10.1.7",
    "@namma/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
