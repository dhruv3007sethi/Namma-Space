# --- API -------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Postgres connection string (docker compose up -d db provides this one)
DATABASE_URL=postgres://namma:namma@localhost:5432/namma_space
# Comma-separated list of allowed browser origins, or * for any
CORS_ORIGINS=http://localhost:5173
# Where uploaded captures are stored (relative to apps/api when run via pnpm)
STORAGE_DIR=./storage
# Per-file upload limit in megabytes
MAX_UPLOAD_MB=500

# Used by integration tests (database is wiped on every run)
TEST_DATABASE_URL=postgres://namma:namma@localhost:5432/namma_space_test

# --- Web -------------------------------------------------------------------
# Leave empty to use the Vite dev proxy / same-origin deployment
VITE_API_BASE_URL=
# Where the Vite dev server proxies /api and /health
VITE_API_PROXY_TARGET=http://localhost:4000
# Extra hostnames allowed to reach the Vite dev server (comma-separated), or true for any
VITE_ALLOWED_HOSTS=
